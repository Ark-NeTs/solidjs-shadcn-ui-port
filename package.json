{
  "name": "shadcn-solidjs-theme",
  "version": "0.0.1",
  "description": "SolidJS design system (D49): the solid-ui (Kobalte/corvu) component set plus the shared oklch Tailwind theme, encapsulated behind per-component package exports",
  "private": true,
  "type": "module",
  "main": "./dist/shadcn-solidjs-theme.js",
  "module": "./dist/shadcn-solidjs-theme.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "solid": "./src/index.ts",
      "import": "./dist/shadcn-solidjs-theme.js"
    },
    "./theme.css": "./src/theme.css",
    "./styles.css": "./dist/shadcn-solidjs-theme.css",
    "./utils": "./src/lib/utils.ts",
    "./*": "./src/components/ui/*.tsx"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "bunx --bun vite build",
    "typecheck": "bunx --bun tsc --noEmit",
    "test": "bunx --bun vitest run",
    "test:watch": "bunx --bun vitest",
    "fetch-registry": "bun scripts/fetch-registry.ts",
    "normalize-imports": "bun scripts/normalize-imports.ts",
    "sizes": "bun scripts/measure-sizes.ts"
  },
  "dependencies": {
    "@corvu/drawer": "^0.2.4",
    "@fontsource-variable/inter": "^5.2.8",
    "@kobalte/core": "0.13.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "solid-sonner": "^0.3.1",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "peerDependencies": {
    "solid-js": "^1.9.14"
  },
  "devDependencies": {
    "@solidjs/testing-library": "^0.8.10",
    "@tailwindcss/vite": "^4.3.2",
    "@testing-library/jest-dom": "^6.9.1",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.3.2",
    "typescript": "^6.0.3",
    "vite": "^8.1.3",
    "vite-plugin-dts": "^5.0.3",
    "vite-plugin-solid": "^2.11.12",
    "vitest": "^4.1.10"
  }
}
