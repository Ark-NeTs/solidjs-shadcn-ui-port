{
  "name": "shadcn-solidjs-theme",
  "version": "0.0.1",
  "license": "MIT",
  "private": true,
  "type": "module",
  "description": "Solid 2 design-system foundation (D19/D90): shared tokens and sixty-five component families behind source and build exports.",
  "files": [
    "src",
    "dist"
  ],
  "main": "./dist/shadcn-solidjs-theme.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "solid": "./src/index.ts",
      "import": "./dist/shadcn-solidjs-theme.js"
    },
    "./ui/*": "./src/components/ui/*.tsx",
    "./utils": "./src/lib/utils.ts",
    "./hooks/*": "./src/hooks/*.ts",
    "./theme.css": "./src/theme.css",
    "./styles.css": "./dist/shadcn-solidjs-theme.css"
  },
  "scripts": {
    "dev": "bun run docs:generate && vite --config playground/vite.config.ts",
    "build": "vite build && tsc -p tsconfig.build.json",
    "build:playground": "bun run docs:generate && vite build --config playground/vite.config.ts",
    "check": "tsc --noEmit",
    "typecheck": "bun run check",
    "lint": "eslint src tests playground scripts *.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:integration": "playwright test tests/integration",
    "test:e2e": "THEME_PRODUCTION=1 playwright test tests/e2e",
    "test:server": "vitest run --config vitest.server.config.ts",
    "parity:report": "bun scripts/check-admin-parity.ts",
    "parity:admin": "bun scripts/check-admin-parity.ts --strict",
    "build:hydration": "node --conditions=development scripts/build-hydration.mjs",
    "test:hydration": "playwright test --config playwright.hydration.config.ts",
    "docs:generate": "bun scripts/build-docs.mjs",
    "docs:check": "node scripts/check-doc-examples.mjs",
    "sizes:consumer": "bun run build && node scripts/measure-consumer-bundles.mjs",
    "test:consumer": "playwright test --config playwright.consumer.config.ts",
    "build:site": "bun scripts/build-site.mjs",
    "test:site": "playwright test --config playwright.site.config.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.2.8",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "tailwindcss": "4.3.3",
    "@floating-ui/dom": "1.8.0",
    "@kobalte/core": "2.0.0-alpha.2",
    "embla-carousel": "8.6.0",
    "@tanstack/table-core": "8.21.3",
    "chart.js": "4.5.1"
  },
  "peerDependencies": {
    "solid-js": "2.0.0-rc.13",
    "@solidjs/web": "2.0.0-rc.13"
  },
  "devDependencies": {
    "solid-js": "2.0.0-rc.13",
    "@solidjs/web": "2.0.0-rc.13",
    "@solidjs/testing-library": "1.0.0-beta.3",
    "vite-plugin-solid": "3.0.0-next.27",
    "vite": "8.3.3",
    "vitest": "4.1.10",
    "@vitest/coverage-v8": "4.1.10",
    "jsdom": "29.1.1",
    "@testing-library/jest-dom": "6.9.1",
    "@playwright/test": "1.63.0",
    "@axe-core/playwright": "4.11.0",
    "typescript": "5.9.3",
    "@types/node": "25.3.0",
    "@tailwindcss/vite": "4.3.3",
    "eslint": "9.39.1",
    "typescript-eslint": "8.57.1"
  },
  "overrides": {
    "solid-js": "2.0.0-rc.13",
    "@solidjs/web": "2.0.0-rc.13",
    "@solidjs/signals": "2.0.0-rc.13"
  }
}
